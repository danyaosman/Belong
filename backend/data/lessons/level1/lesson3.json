        "hint": "You can say: Bir simit istiyorum.",
        "required": true
      },
      {
        "id": 3,
        "character_message": "Tabii! Başka bir şey ister misin?",
        "expected_intent": "ask_for_something_else",
        "target_phrases": [
          "Hayır, teşekkür ederim",
          "Bir su daha istiyorum",
          "Evet, bir çay daha istiyorum"
        ],
        "hint": "You can say: Hayır, teşekkür ederim.",
        "required": true
      },
      {
        "id": 4,
        "character_message": "Afiyet olsun! Yine bekleriz. İyi günler!",
        "expected_intent": "thank_and_say_goodbye",
        "target_phrases": [
          "Teşekkür ederim, görüşürüz",
          "Sağ ol, iyi günler",
          "Teşekkürler"
        ],
        "hint": "You can say: Teşekkür ederim, görüşürüz!",
        "required": true
      }
    ]
  },

