  "grammar": [
    {
      "title": "Making polite requests",
      "explanation": "Use 'istiyorum' to say what you want. Add 'lütfen' to make your request more polite. You can also use 'alabilir miyim?' to politely ask for something.",
      "example": "Bir çay istiyorum, lütfen. / Bir simit alabilir miyim?",
      "translation": "I would like a tea, please. / Can I have a simit?"
    }
  ],

