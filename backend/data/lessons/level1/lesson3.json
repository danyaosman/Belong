        "id": 1,
        "character_message": "Merhaba! Hoş geldin! Ne içmek istersin?",
        "expected_intent": "order_a_drink",
        "target_phrases": [
          "Bir Türk kahvesi istiyorum",
          "Bir çay istiyorum",
          "Bir su istiyorum"
