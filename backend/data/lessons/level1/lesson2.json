  "grammar": [
    {
      "title": "Present continuous (-iyor)",
      "explanation": "Use the -iyor form to talk about actions happening now or activities that you regularly do. The ending changes depending on the verb and vowel harmony.",
      "example": "Gidiyorum. / Çalışıyorum. / Öğreniyorum.",
      "translation": "I am going. / I am studying. / I am learning."
    }
  ],

