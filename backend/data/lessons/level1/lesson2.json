    ],

    "steps": [
      {
        "id": 1,
        "character_message": "Günaydın! Sabahları genellikle saat kaçta kalkıyorsun?",
        "expected_intent": "talk_about_morning_routine",
        "target_phrases": [
          "Saat yedide kalkıyorum",
          "Saat sekizde kalkıyorum",
          "Sabah erken kalkıyorum"
        ],
        "hint": "You can say: Saat yedide kalkıyorum.",
        "required": true
      },
      {
        "id": 2,
        "character_message": "Anladım! Peki, sabah kahvaltı yapıyor musun?",
        "expected_intent": "talk_about_breakfast",
        "target_phrases": [
          "Evet, kahvaltı yapıyorum",
          "Hayır, kahvaltı yapmıyorum",
          "Sabah kahvaltı yapıyorum"
        ],
        "hint": "You can say: Evet, kahvaltı yapıyorum.",
        "required": true
      },
      {
        "id": 3,
        "character_message": "Ben de kahvaltıdan sonra üniversiteye gidiyorum. Sen üniversiteye nasıl gidiyorsun?",
        "expected_intent": "talk_about_transportation_to_university",
        "target_phrases": [
          "Otobüsle gidiyorum",
          "Metro ile gidiyorum",
          "Yürüyerek gidiyorum"
        ],
        "hint": "You can say: Otobüsle gidiyorum.",
        "required": true
      },
      {
        "id": 4,
        "character_message": "Ben üniversitede ders çalışıyorum ve Türkçe öğreniyorum. Sen derslerden sonra ne yapıyorsun?",
        "expected_intent": "talk_about_studying_and_free_time",
        "target_phrases": [
          "Ders çalışıyorum",
          "Ödev yapıyorum",
          "Kitap okuyorum",
          "Müzik dinliyorum",
          "Film izliyorum"
        ],
        "hint": "You can say: Derslerden sonra kitap okuyorum.",
        "required": true
      },
      {
        "id": 5,
        "character_message": "Güzel! Bugün görüşürüz!",
        "expected_intent": "say_goodbye",
        "target_phrases": [
          "Görüşürüz"
        ],
        "hint": "You can say: Görüşürüz!",
        "required": true
      }
    ]
  },

